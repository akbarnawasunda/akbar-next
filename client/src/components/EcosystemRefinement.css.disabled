/* ============================================================
   ECOSYSTEM REFINEMENT
   File ini dulunya SUMBER utama kebocoran warna ungu ke halaman
   dalam. Sekarang semua dekorasi dihapus.
   Yang tersisa: hanya label dan garis tipis.
   ============================================================ */

/* -- 1. PAGE WRAPPER --------------------------------------- */
.nf-page {
  position: relative;
  isolation: isolate;
  background: var(--ink);
}

/* Grid overlay 54px — DIHAPUS */
.nf-page::before { content: none !important; display: none !important; }

/* -- 2. HERO ----------------------------------------------- */
.nf-page-hero {
  position: relative;
  overflow: hidden;
}

/* Label "AN // ARTIST SIGNAL" — diganti jadi lebih tenang */
.nf-page-hero::after {
  content: "AN / SIGNAL";
  position: absolute;
  right: var(--gutter, clamp(20px, 4.5vw, 64px));
  bottom: 22px;
  font-family: var(--font-mono);
  font-size: 0.58rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  color: var(--mute-soft);
  text-transform: uppercase;
  pointer-events: none;
}

/* Gradient violet + acid overlay — DIHAPUS */
.nf-page-hero::before { content: none !important; display: none !important; }

.nf-page-hero > *,
.nf-page-hero > div {
  position: relative;
  z-index: 1;
}

.nf-page-hero h1 {
  text-shadow: none;
}

/* -- 3. HERO NOTE ------------------------------------------ */
.nf-hero-note {
  box-shadow: none;
}
/* Label "NOW TUNED" — DIHAPUS, sudah ada label bawaan di MaturePalette */
.nf-hero-note::before { content: none !important; display: none !important; }

/* -- 4. SECTION TITLE -------------------------------------- */
.nf-section {
  position: relative;
}
.nf-section-title {
  position: relative;
}
/* Garis accent acid di bawah title — diganti warna acid baru */
.nf-section-title::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -20px;
  width: min(64px, 20vw);
  height: 2px;
  background: var(--acid);
}

/* -- 5. CARD HOVER ----------------------------------------- */
.nf-catalog-card,
.nf-visual-card,
.nf-event-card,
.nf-universe-card,
.nf-press-card {
  transition: background var(--dur-fast, 160ms) var(--ease, ease), border-color var(--dur-fast, 160ms) var(--ease, ease);
}
.nf-catalog-card:hover,
.nf-visual-card:hover,
.nf-event-card:hover,
.nf-universe-card:hover,
.nf-press-card:hover {
  transform: none;
  box-shadow: none;
  background: color-mix(in srgb, var(--paper) 4%, transparent);
}

/* -- 6. BUTTONS -------------------------------------------- */
.nf-button,
.nf-text-button {
  transition: background var(--dur-fast, 160ms) var(--ease, ease), color var(--dur-fast, 160ms) var(--ease, ease), border-color var(--dur-fast, 160ms) var(--ease, ease);
}
.nf-button:active,
.nf-text-button:active {
  transform: scale(0.97);
}

/* -- 7. SIGNAL BLOCK --------------------------------------- */
.nf-signal-block {
  position: relative;
  overflow: hidden;
}
/* Blob violet blur di sudut — DIHAPUS */
.nf-signal-block::before { content: none !important; display: none !important; }

.nf-signal-block > * {
  position: relative;
  z-index: 1;
}

/* -- 8. RESPONSIVE ----------------------------------------- */
@media (max-width: 820px) {
  .nf-page-hero::after {
    right: 20px;
    bottom: 18px;
    font-size: 0.5rem;
  }
  .nf-page-hero {
    min-height: 0;
  }
  .nf-section-title::after {
    bottom: -14px;
    width: 48px;
  }
  .nf-catalog-card:active,
  .nf-visual-card:active,
  .nf-event-card:active,
  .nf-universe-card:active,
  .nf-press-card:active {
    transform: scale(0.985);
  }
}

/* -- 9. REDUCED MOTION ------------------------------------ */
@media (prefers-reduced-motion: reduce) {
  .nf-catalog-card,
  .nf-visual-card,
  .nf-event-card,
  .nf-universe-card,
  .nf-press-card,
  .nf-button,
  .nf-text-button {
    transition: none;
  }
}
