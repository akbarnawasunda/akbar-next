{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/trpc.js": {
      "maxDuration": 30
    },
    "api/ssr.js": {
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  },
  "redirects": [
    {
      "source": "/epk.html",
      "destination": "/epk",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/archive",
      "destination": "/universe",
      "permanent": true
    }
  ],
  "routes": [
    {
      "source": "/api/trpc(?:/(.*))?$",
      "destination": "/api/trpc.js?trpcPath=$1"
    },
    {
      "source": "/api/brand/rmx-mark",
      "destination": "https://akbarfolio-424qdvsv.manus.space/manus-storage/akbar-nawasunda-rmx-mark_d59968bf.jpg"
    },
    {
      "source": "/manus-storage/akbar-nawasunda-official-portrait_2c39f68f.jpg",
      "destination": "https://akbarfolio-424qdvsv.manus.space/manus-storage/akbar-nawasunda-official-portrait_2c39f68f.jpg"
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/akbar-favicon.jpg"
    },
    {
      "source": "/favicon.png",
      "destination": "/assets/akbar-favicon.jpg"
    },
    {
      "source": "/(?:en|music|visuals|live|universe|about|inquire|licensing|epk|privacy)(?:/(.*))?$",
      "destination": "/api/ssr.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "source": "/(.*)",
      "destination": "/api/ssr.js"
    }
  ],
  "headers": [
    {
      "source": "/api/trpc",
      "headers": [{ "key": "cache-control", "value": "no-store" }]
    },
    {
      "source": "/api/trpc/:path*",
      "headers": [{ "key": "cache-control", "value": "no-store" }]
    }
  ]
}
