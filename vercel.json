{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "redirects": [
    {
      "source": "/epk.html",
      "destination": "/epk",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/trpc",
      "destination": "https://akbarfolio-424qdvsv.manus.space/api/trpc"
    },
    {
      "source": "/api/trpc/:path*",
      "destination": "https://akbarfolio-424qdvsv.manus.space/api/trpc/:path*"
    },
    {
      "source": "/api/brand/rmx-mark",
      "destination": "https://akbarfolio-424qdvsv.manus.space/manus-storage/akbar-nawasunda-rmx-mark_d59968bf.jpg"
    },
    {
      "source": "/manus-storage/akbar-nawasunda-official-portrait_2c39f68f.jpg",
      "destination": "https://akbarfolio-424qdvsv.manus.space/manus-storage/akbar-nawasunda-official-portrait_2c39f68f.jpg"
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/akbar-favicon.jpg"
    },
    {
      "source": "/favicon.png",
      "destination": "/assets/akbar-favicon.jpg"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/trpc",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    },
    {
      "source": "/api/trpc/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
